DEPLOY_CHAIN_TARGET="local" # local, testnet, or mainnet
DEPLOY_WAVS_TARGET="local" # local or remote
DEPLOY_IPFS_TARGET="local" # local or remote

# currently, we deploy a single proxy contract and need to associate it with a known user
# for the "deploy all" flow to work correctly
DEPLOY_REGISTER_USER_EMAIL="alice@example.com"

# Space-separated Hydro control center addresses for testnet/mainnet deployments.
# Local deployment automatically deploys a control center with no vaults and uses its address.
DEPLOY_CONTROL_CENTER_ADDRESS="neutron1vk3cy35cudlpk8w9kuu9prcanc49n3ajcnu86a43ue9ln6v4v6zsaucnw9 neutron1d054u05vx29k20gqrj5h2h2lz7pl7x9fch4ypl5jmaj6q5yw4vgsgk4lx0 neutron1c3djqnwur4aryxe7knr4kvcm3hj2wvnl5887lc5dwsh7z40pf2cq9flznr"

REMOTE_WAVS_OPERATOR_URL_1="http://example.com/operator-1" # needed for remote operator-registration
REMOTE_WAVS_OPERATOR_URL_2="http://example.com/operator-2"

REMOTE_IPFS_KIND="pinata" # kubo, pinata
# if using kubo for ipfs remote kind
REMOTE_IPFS_API_URL="http://example.com/ipfs-api"
REMOTE_IPFS_GATEWAY_URL="https://example.mypinata.cloud"
# If using pinata for ipfs remote kind
REMOTE_IPFS_PINATA_JWT=""
REMOTE_IPFS_PINATA_GROUP_ID="" # optional, if used then the JWT must have group-write permission


CLI_MNEMONIC=""
# Backend: see docs/Backend.md. Tests need only Postgres + BACKEND_DATABASE_URL.
# Local Docker password; must match the local URL below.
BACKEND_POSTGRES_PASSWORD="hydro_local_dev_only"
# Used by both the API and `task backend:api-test`; replace for hosted Postgres.
BACKEND_DATABASE_URL="postgres://hydro:hydro_local_dev_only@127.0.0.1:5433/hydro_email"
BACKEND_LISTEN="127.0.0.1:8080" # API HTTP address
BACKEND_API_URL="http://127.0.0.1:8080" # Backend URL reachable from WAVS operators and aggregators
# Private server-to-server credential; replace this local example for hosted use.
BACKEND_API_KEY="local-development-only-secret-32-characters"
BACKEND_CHAIN_KEY="dev:local" # Chain configuration in wavs.toml
BACKEND_USER_REGISTRY_ADDRESS="local-test-registry" # Placeholder for API-only testing
BACKEND_SERVICE_HANDLER_ADDRESS="local-test-handler" # Required; replace with deployed handler (proxy admin)
# Rolling limits on new registrations and explicit retries per chain.
BACKEND_REGISTRATIONS_PER_HOUR=10
BACKEND_REGISTRATIONS_PER_DAY=50
BACKEND_PROVISIONING_ENABLED=false # Enable to process queued registrations on-chain
# Required only for provisioning; also replace the registry and handler placeholders above.
BACKEND_PROXY_CODE_ID=0
BACKEND_CONTROL_CENTER_ADDRESSES="" # Space-separated addresses
BACKEND_SIGNING_MNEMONIC="" # Funded registry-authorized wallet; do not share with other submitters

TEST_ON_CHAIN_REMOTE_MNEMONIC="" # only used when testing on testnet/mainnet, not needed for local
WAVS_OPERATOR_SIGNING_MNEMONIC_1=""
WAVS_OPERATOR_SIGNING_MNEMONIC_2=""
WAVS_AGGREGATOR_COSMOS_CREDENTIAL_1=""

WAVS_ENV_IMAP_DEBUG_CAPABILITIES=true

# AgentMail over plain IMAP
# Generate the API key here: https://console.agentmail.to/dashboard/api-keys
WAVS_ENV_MAIL_CREDENTIAL_KIND="plain-imap"
WAVS_ENV_IMAP_PORT=993
WAVS_ENV_IMAP_HOST="imap.agentmail.to"
WAVS_ENV_IMAP_TLS=true
WAVS_ENV_IMAP_USERNAME="<your-inbox>@agentmail.to"
WAVS_ENV_IMAP_PASSWORD="<AgentMail API key>"

# NOT YET IMPLEMENTED: AgentMail REST API (will error if selected)
# WAVS_ENV_MAIL_CREDENTIAL_KIND="agentmail-rest-api"
# WAVS_ENV_AGENTMAIL_API_KEY="<AgentMail API key>"
# WAVS_ENV_AGENTMAIL_INBOX_ID="<your-inbox>@agentmail.to"
# WAVS_ENV_AGENTMAIL_BASE_URL="https://api.agentmail.to/v0" # optional, defaults to this

# For local dev, set these instead of the AgentMail values above
# WAVS_ENV_MAIL_CREDENTIAL_KIND="plain-imap"
# WAVS_ENV_IMAP_PORT=3143
# WAVS_ENV_IMAP_HOST="127.0.0.1"
# WAVS_ENV_IMAP_TLS=false
# WAVS_ENV_IMAP_USERNAME="hello@example.com"
# WAVS_ENV_IMAP_PASSWORD="world"

# TASK_HELPER_DEV_MODE="true" # if set, uses `cargo run` instead of the built task-helper binary
